# Copy to .env for local development. On Vercel set the same names under
# Project → Settings → Environment Variables (see docs/SETUP.md).
SHOPIFY_API_KEY=            # Partner dashboard → app → Client ID
SHOPIFY_API_SECRET=         # Partner dashboard → app → Client secret
SHOPIFY_APP_URL=https://easy-seo-meta.vercel.app
SCOPES=read_products,write_products,read_online_store_pages,write_online_store_pages,read_online_store_navigation,write_online_store_navigation,read_files,write_files,write_app_proxy
# Neon Postgres: pooled for the app, direct (unpooled) for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# true = test charges (no money moves). Locally this is the default anyway.
# On production leave it unset (real charges) once the app is approved.
SHOPIFY_BILLING_TEST=true
# Free AI meta writing: a key from https://aistudio.google.com/apikey (no billing needed).
# Leave empty to hide the AI buttons. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
# Contact address shown on the public /privacy page.
SUPPORT_EMAIL=
